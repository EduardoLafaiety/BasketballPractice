# URL base da API. Em dev deixe vazio: o Vite faz proxy de /api para http://localhost:3333.
# Em produção, aponte para a API (e libere a origem do site em CORS_ORIGIN no backend).
# VITE_API_URL=https://api.exemplo.com/api

# Destino do proxy /api em dev (padrão http://localhost:3333).
# API_PROXY=http://localhost:3333
