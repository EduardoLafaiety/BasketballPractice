PORT=3333
# Em produção a API não sobe com este valor nem com menos de 32 caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-longo-e-aleatorio
JWT_EXPIRES_IN=7d
DATABASE_URL=postgres://basketball:basketball@localhost:5433/basketball
CORS_ORIGIN=http://localhost:5173
# Atrás de um proxy (Nginx, Render, Railway…): 1, para o limite de tentativas usar o IP do atleta
TRUST_PROXY=0
# Tentativas erradas de login/cadastro por IP a cada 15 minutos
AUTH_ATTEMPTS=10
# Senhas erradas por conta a cada 15 minutos, de qualquer IP
ACCOUNT_ATTEMPTS=20
# Contas criadas por IP a cada hora
REGISTRATIONS_PER_HOUR=30
# Importações de backup ao mesmo tempo nesta instância
MAX_IMPORTS=2
# Chave grátis em https://gnews.io (uso não comercial, notícias com 12 h de atraso). Vazia: a barra mostra só as manchetes do admin
GNEWS_API_KEY=
# Minutos entre as buscas de notícias. O plano grátis tem 100 consultas por dia: não use menos de 15
NEWS_INTERVAL_MINUTES=20
# Endereço do site, usado nos links dos e-mails. Vazio: usa CORS_ORIGIN
APP_URL=
# Quem envia os e-mails de ativação e de recuperação de senha:
#   vazio    não envia e registra um aviso (sem o link); ninguém consegue ativar conta nova
#   console  mostra o e-mail no terminal; só para desenvolvimento, a API não sobe assim em produção
#   arquivo  grava em EMAIL_OUTBOX_FILE; só para testes, a API não sobe assim em produção
#   resend   envia pelo https://resend.com; precisa de RESEND_API_KEY e EMAIL_FROM
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
# Pedidos de "esqueci a senha" por IP a cada hora
RECOVERY_REQUESTS_PER_HOUR=10
# E-mails de cadastro e de recuperação que cada endereço recebe por hora
EMAILS_PER_ADDRESS_PER_HOUR=5
